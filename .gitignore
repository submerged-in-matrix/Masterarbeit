# --- bytecode / caches ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- virtual envs ---
.env/
.venv/
*.egg-info/

# --- large artifacts & outputs ---
data/raw/
data/interim/
data/processed/
results/
outputs/
/models/              # ignore only top-level 'models' dir (artifacts)
/checkpoints/          # ignore only top-level 'checkpoints' dir (artifacts)
*.h5
*.pt
*.pth
*.pkl
*.joblib
*.npz
*.npy
*.csv
*.png
*.jpg
*.pdf

# --- exceptions: always keep source code tracked ---
!src/models/**
!scripts/**